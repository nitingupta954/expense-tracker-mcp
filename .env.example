# Copy this file to .env and fill in your values.

# Database URLs for PostgreSQL
# Create a Neon or local PostgreSQL database and provide the connection URL.
DATABASE_URL=postgresql://user:password@host:5432/dbname
TEST_DATABASE_URL=postgresql://user:password@host:5432/dbname_test

# Default currency for all expense formatting.
# Supported: INR, USD, EUR, GBP, JPY, AUD, CAD, SGD, AED
EXPENSE_DEFAULT_CURRENCY=INR

# ── Google OAuth Configuration ──
# Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application) and paste the values below.
OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=GOCSPX-your-google-client-secret
OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
